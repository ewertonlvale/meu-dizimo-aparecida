{
  "version": "7.1",
  "screens": [
    {
      "id": "OFERTA",
      "title": "Oferta",
      "terminal": true,
      "data": {
        "comunidades": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "1",
              "title": "Matriz"
            },
            {
              "id": "2",
              "title": "São José"
            }
          ]
        },
        "nome_padrao": {
          "type": "string",
          "__example__": "Maria"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "form_oferta",
            "init-values": {
              "nome": "${data.nome_padrao}"
            },
            "children": [
              {
                "type": "TextSubheading",
                "text": "Sua oferta"
              },
              {
                "type": "TextBody",
                "text": "Escolha a comunidade que vai receber."
              },
              {
                "type": "Dropdown",
                "name": "comunidade",
                "label": "Comunidade",
                "required": true,
                "data-source": "${data.comunidades}"
              },
              {
                "type": "TextInput",
                "name": "nome",
                "label": "Seu nome",
                "input-type": "text",
                "required": true,
                "min-chars": 2,
                "max-chars": 60
              },
              {
                "type": "TextInput",
                "name": "valor",
                "label": "Valor (R$)",
                "input-type": "number",
                "required": true,
                "helper-text": "Só o valor. Ofereça o que sentir no coração."
              },
              {
                "type": "Footer",
                "label": "Continuar",
                "on-click-action": {
                  "name": "complete",
                  "payload": {
                    "comunidade": "${form.comunidade}",
                    "nome": "${form.nome}",
                    "valor": "${form.valor}"
                  }
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
