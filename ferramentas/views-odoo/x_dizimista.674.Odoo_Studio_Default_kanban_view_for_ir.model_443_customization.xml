<!-- x_dizimista · view 674 · Odoo Studio: Default kanban view for ir.model(443,) customization · herda de 673 · prioridade 99 -->
<data>
  <xpath expr="/kanban/templates" position="inside">
    <t t-name="card" class="row g-0">
      <main class="col-10">
        <footer>
          <field name="x_studio_comunidade" display="full"/>
        </footer>
      </main>
    </t>
  </xpath>
  <xpath expr="/kanban/templates/t[@t-name='card'][2]/main/footer" position="before">
    <xpath expr="/kanban/templates/t[@t-name='card']" position="move"/>
  </xpath>
  <xpath expr="/kanban/templates/t[@t-name='card']/main/t[@t-name='card']" position="attributes">
    <attribute name="t-name"/>
  </xpath>
</data>