<!-- x_comunidade · form combinada (via get_view) · view 601
     SOMENTE LEITURA: é o resultado das heranças, não existe como registro. O modo –update ignora este arquivo. -->
<form>
  <header/>
  <sheet string="Comunidade">
    <widget name="web_ribbon" text="Arquivado" bg_color="text-bg-danger" invisible="x_active"/>
    <field name="x_active" invisible="1"/>
    <div class="oe_title">
      <h1>
        <field name="x_name" required="1" placeholder="Name..."/>
      </h1>
    </div>
    <group name="studio_group_22eae5">
      <group name="studio_group_22eae5_left">
        <field name="x_studio_coordenador" can_create="True" can_write="True"/>
        <field name="x_studio_whatsapp_coordenador"/>
        <separator string="Recebimento PIX"/>
        <field name="x_studio_chave_pix"/>
        <field name="x_studio_titular_conta"/>
        <field name="x_studio_banco"/>
        <field name="x_studio_chave_acesso"/>
      </group>
      <group name="studio_group_22eae5_right">
        <separator string="Endereço"/>
        <field name="x_studio_partner_id" options="{'no_quick_create': True}" on_change="1" can_create="True" can_write="True"/>
        <!-- Os cinco campos abaixo são RELACIONADOS ao parceiro: escrever neles escreve nele. Sem parceiro escolhido não há onde gravar, e o texto digitado sumiria ao salvar sem dizer por quê. Por isso só aparecem depois que há um, e no lugar deles fica a instrução. -->
        <div colspan="2" class="text-muted fst-italic" invisible="x_studio_partner_id">
          Escolha ou crie um contato acima para informar o endereço.
        </div>
        <field name="x_studio_rua" invisible="not x_studio_partner_id"/>
        <field name="x_studio_complemento" invisible="not x_studio_partner_id"/>
        <field name="x_studio_cidade" invisible="not x_studio_partner_id"/>
        <field name="x_studio_uf" invisible="not x_studio_partner_id" can_create="True" can_write="True"/>
        <field name="x_studio_cep" invisible="not x_studio_partner_id"/>
        <!-- O mapa prefere a coordenada gravada; só geocodifica o endereço quando ela falta. Deixar as duas à vista é o que permite acertar na porta em vez de aceitar o centroide do bairro que o Nominatim devolve. -->
        <!-- O Odoo em português lê PONTO como separador de milhar. Colar "-5.1162917" do Google Maps vira -51162917, e o pino some do mapa sem erro nenhum. A instrução diz a vírgula porque o formato certo não é adivinhável a partir do que o Google entrega. -->
        <div colspan="2" class="text-muted small mt-2" invisible="not x_studio_partner_id">
          Coordenada (opcional): no Google Maps, botão direito sobre o local copia o par de números. Troque o ponto por
          <b>
            vírgula
          </b>
          ao colar — aqui
          <code>
            -5.1162917
          </code>
          precisa virar
          <code>
            -5,1162917
          </code>
          . Em branco, o mapa tenta adivinhar pelo endereço.
        </div>
        <field name="x_studio_latitude" invisible="not x_studio_partner_id"/>
        <field name="x_studio_longitude" invisible="not x_studio_partner_id"/>
        <!-- O QR Code SAIU DA TELA (BL-63). Era uma imagem que alguém colava no cadastro, e que o bot nunca leu: `x_studio_qr_code` não aparece uma única vez no Apps Script. Quem gera o QR é o MediaService, na hora do pagamento, montando o BR Code a partir de `x_studio_chave_pix` — e o card nativo da Meta nem imagem usa. Pedir a imagem no cadastro era pedir um dado que só podia envelhecer: trocada a chave, a figura continuaria mostrando a antiga. O CAMPO CONTINUA EXISTINDO no Odoo, com as imagens que já estiverem nele. Tirar da tela é reversível; apagar campo de imagem não é, e essa decisão não é de uma revisão de formulário. Se a paróquia usa essa figura para IMPRIMIR cartaz, basta devolver estas duas linhas. -->
      </group>
    </group>
    <notebook name="studio_notebook_8fu_1jhobjioi">
      <page string="Dizimistas" name="studio_page_8fu">
        <group name="studio_group_8fu">
          <group name="studio_group_8fu_left"/>
          <group name="studio_group_8fu_right"/>
        </group>
        <field name="x_studio_dizimistas">
          <list>
            <field name="x_studio_sequence" widget="handle"/>
            <field name="x_name"/>
            <field name="x_studio_nome_completo" optional="hide"/>
            <field name="x_studio_partner_phone" optional="show"/>
            <field name="x_studio_comunidade" optional="show"/>
            <field name="x_studio_date" optional="show"/>
            <field name="x_studio_devolucoes" optional="show"/>
            <field name="x_studio_currency_id" invisible="&#10;      False&#10;    " column_invisible="&#10;      True&#10;    "/>
            <field name="x_studio_value" sum="Total"/>
            <field name="write_date" optional="hide" string="Última alteração"/>
            <field name="x_studio_classificacao" optional="show" widget="badge" decoration-success="x_studio_classificacao == 'Regular'" decoration-warning="x_studio_classificacao == 'Eventual'" decoration-muted="x_studio_classificacao == 'Inativo'"/>
            <field name="x_studio_notificacao_ativa" optional="show" string="Recebe lembrete"/>
          </list>
        </field>
      </page>
      <page string="Devoluções" name="studio_page_3g1_1jhobldgd">
        <group name="studio_group_3g1">
          <group name="studio_group_3g1_left"/>
          <group name="studio_group_3g1_right"/>
        </group>
        <field name="x_studio_devolucoes">
          <list create="&#10;      true&#10;    " default_order="&#10;      x_studio_data_da_devolucao desc&#10;    " delete="&#10;      true&#10;    " duplicate="&#10;      false&#10;    " multi_edit="&#10;      false&#10;    ">
            <field name="x_studio_sequence" widget="handle"/>
            <field name="x_studio_dizimista" optional="show" can_create="True" can_write="True"/>
            <field name="x_studio_tipo_contribuicao" optional="show"/>
            <field name="x_studio_comunidade" optional="show" can_create="True" can_write="True"/>
            <field name="x_studio_competencia" optional="show"/>
            <field name="x_studio_data_da_devolucao" optional="show"/>
            <field name="x_studio_forma_de_pagamento" optional="show"/>
            <!-- BL-61: some do padrão em vez de mostrar `tudo_divergente` numa coluna. Coluna de lista não tem onde traduzir um char — o formulário e o card traduzem com `invisible` por valor, a lista não tem esse recurso. Continua disponível no menu de colunas opcionais para quem quiser o código cru; quem só quer saber se precisa olhar tem o badge de status e o de validação ao lado. -->
            <field name="x_studio_conferencia_pix" optional="hide" string="Conferência (código)"/>
            <field name="x_studio_currency_id" column_invisible="&#10;      True&#10;    " optional="&#10;      show&#10;    " can_create="True" can_write="True"/>
            <field name="x_studio_value" sum="Total"/>
            <field name="x_studio_status" optional="show" widget="badge" string="Leitura do bot" decoration-success="x_studio_status == 'Confirmado'" decoration-danger="x_studio_status == 'Rejeitado'" decoration-warning="x_studio_status == 'Pendente'" decoration-muted="x_studio_status == 'A devolver'"/>
            <!-- As duas colunas juntas, de propósito (BL-60). Uma é o que o bot leu no comprovante; a outra é o que o coordenador viu no extrato. É a LINHA em que elas discordam — bot diz Confirmado, coordenador diz Não recebido — que a paróquia precisa achar, e ela só existe se as duas estiverem à vista lado a lado. -->
            <field name="x_studio_validacao" optional="show" widget="badge" string="Validação" decoration-success="x_studio_validacao == 'validado'" decoration-danger="x_studio_validacao == 'nao_recebido'" decoration-muted="x_studio_validacao == 'a_validar'"/>
            <field name="write_date" optional="hide" string="Última alteração"/>
          </list>
        </field>
      </page>
      <page string="Usuários Pastoral" name="studio_page_29o_1jhok4sk1">
        <group name="studio_group_29o">
          <group name="studio_group_29o_left"/>
          <group name="studio_group_29o_right"/>
        </group>
        <field name="x_studio_usuarios" can_create="True" can_write="True">
          <list string="Users" multi_edit="1" delete="false" duplicate="false">
            <field name="avatar_128" widget="image" options="{'size': [24, 24], 'img_class': 'o_avatar rounded'}" width="30" nolabel="1" on_change="1"/>
            <field name="name" readonly="1" on_change="1"/>
            <field name="login" readonly="1" optional="show" on_change="1"/>
            <field name="group_ids" optional="show" widget="many2many_tags" on_change="1" can_create="True" can_write="True"/>
            <field name="lang" optional="hide" on_change="1"/>
            <field name="login_date" readonly="1" optional="hide"/>
            <field name="role" widget="badge" on_change="1"/>
            <field name="state" widget="badge" optional="hide" decoration-info="state == 'new'" decoration-success="state == 'active'"/>
          </list>
        </field>
      </page>
    </notebook>
  </sheet>
  <chatter/>
</form>