<!-- x_devolucao · view 608 · Odoo Studio: Default form view for x_devolucao customization · herda de 604 · form · prioridade 99 -->
<data>
  <xpath expr="/form/header" position="inside">
    <field widget="statusbar" options="{'clickable': '1'}" name="x_studio_status"/>
  </xpath>

  <!-- O alerta da conferência sai do meio do formulário e vira banner no topo.
       Ele estava como um campo de texto entre outros dez, e é a informação que
       decide se este registro precisa de atenção humana. Some quando está 'ok',
       que é a maioria e não é notícia. -->
  <xpath expr="/form//div[@class='oe_title']" position="before">
    <div class="alert alert-warning mb-3" role="alert"
         invisible="not x_studio_conferencia_pix or x_studio_conferencia_pix == 'ok'">
      <i class="fa fa-exclamation-triangle me-2" role="img" aria-label="Atenção"/>
      <span class="fw-bold">Precisa de conferência:</span>
      <field name="x_studio_conferencia_pix" readonly="1" nolabel="1" class="d-inline"/>
    </div>
  </xpath>

  <xpath expr="/form//field[@name='x_studio_currency_id']" position="after">
    <field name="x_studio_tipo_contribuicao" force_save="0" readonly="False" required="1"/>
    <field name="x_studio_dizimista" options="{&quot;create_name_field&quot;:&quot;x_name&quot;,&quot;no_create&quot;:true}"/>
    <!-- BL-41: o bot grava nome e telefone de quem ofertou sem ser cadastrado,
         e nenhum dos dois aparecia no formulário. Uma oferta anônima chegava à
         secretaria como um registro sem dono, com o dado ali do lado, invisível. -->
    <field name="x_studio_nome_ofertante" invisible="x_studio_dizimista"/>
    <field name="x_studio_telefone_ofertante" widget="phone" invisible="x_studio_dizimista"/>
    <field name="x_studio_comunidade" options="{&quot;create_name_field&quot;:&quot;x_name&quot;,&quot;no_create&quot;:true}" required="1"/>
    <field name="x_studio_competencia" options="{&quot;numeric&quot;:true}" widget="date" string="Mês Referencia"/>
    <field name="x_studio_data_da_devolucao" required="1"/>
  </xpath>

  <!-- Valor obrigatório: dava para salvar uma devolução sem valor nenhum. -->
  <xpath expr="/form//field[@name='x_studio_value']" position="attributes">
    <attribute name="required">1</attribute>
  </xpath>

  <!-- `create_uid` e `write_uid` saem do corpo. Ocupavam lugar nobre entre a
       forma de pagamento e a conferência, e o chatter já registra os dois. -->
  <xpath expr="/form//field[@name='x_studio_value']" position="after">
    <field name="x_studio_forma_de_pagamento"/>
  </xpath>

  <!-- O comprovante sobe para a coluna DIREITA, que estava vazia.
       Ele ficava num segundo grupo, abaixo do primeiro — ou seja, abaixo da
       dobra: para conferir um pagamento era preciso rolar até a imagem,
       memorizar o valor, rolar de volta e comparar. Agora os dados e a imagem
       ficam lado a lado, na mesma tela. -->
  <xpath expr="/form//group[@name='studio_group_c89b90_right']" position="inside">
    <field name="x_studio_tipo_comprovante" invisible="1"/>
    <field name="x_studio_nome_arquivo" invisible="1"/>
    <field name="x_studio_comprovante" widget="image" nolabel="1"
           invisible="x_studio_tipo_comprovante != 'imagem'" string="Comprovante"/>
    <field name="x_studio_comprovante" widget="pdf_viewer" nolabel="1"
           invisible="x_studio_tipo_comprovante != 'pdf'" string="Comprovante"/>
    <div class="text-muted fst-italic" invisible="x_studio_comprovante">
      Sem comprovante anexado.
    </div>
  </xpath>
</data>