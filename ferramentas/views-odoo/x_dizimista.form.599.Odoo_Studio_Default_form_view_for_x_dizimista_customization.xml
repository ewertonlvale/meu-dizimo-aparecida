<!-- x_dizimista · view 599 · Odoo Studio: Default form view for x_dizimista customization · herda de 593 · form · prioridade 99 -->
<data>
  <xpath expr="/form/header" position="inside">
    <field widget="statusbar" options="{'clickable': '1'}" name="x_studio_classificacao"/>
  </xpath>
  <xpath expr="/form//group[@name='studio_group_2352c2']" position="after">
    <group name="studio_group_55t_1jh7ir34m">
      <group name="studio_group_55t_left">
      </group>
      <group name="studio_group_55t_right"/>
    </group>
    <group name="studio_group_2bv_1jh7kqjbg" string="Devoluções">
      <group name="studio_group_2bv_left"/>
      <group name="studio_group_2bv_right"/>
    </group>
    <field name="x_studio_devolucoes"/>
  </xpath>
  <xpath expr="/form//field[@name='x_name']" position="attributes">
    <attribute name="placeholder">
      Nome Usual...
    </attribute>
    <attribute name="string">
      Nome Usual
    </attribute>
  </xpath>
  <xpath expr="/form//field[@name='x_studio_partner_id']" position="replace">
    <field name="x_studio_nome_completo"/>
    <field name="x_studio_cpf"/>
  </xpath>
  <xpath expr="/form//field[@name='x_studio_partner_email']" position="replace"/>
  <xpath expr="/form//field[@name='x_studio_date']" position="after">
    <field name="x_studio_endereco"/>
    <field name="x_studio_data_cadastro"/>
    <field name="x_studio_comunidade" options="{&quot;create_name_field&quot;:&quot;x_name&quot;,&quot;no_create&quot;:true}"/>
    <xpath expr="/form//field[@name='x_studio_value']" position="move"/>
    <field name="x_studio_notificacao_ativa" string="Receber Notificações"/>
    <field name="x_studio_dia_preferido" help="Dia Preferido para Devolução"/>
  </xpath>
  <xpath expr="/form//field[@name='x_studio_partner_phone']" position="attributes">
    <attribute name="string">
      Telefone
    </attribute>
  </xpath>
  <xpath expr="/form//field[@name='x_studio_date']" position="attributes">
    <attribute name="string">
      Data de Nascimento
    </attribute>
  </xpath>
  <xpath expr="/form//field[@name='x_studio_currency_id']" position="after">
    <xpath expr="/form//field[@name='x_studio_image']" position="move"/>
  </xpath>
  <xpath expr="/form//field[@name='x_studio_image']" position="attributes">
    <attribute name="class"/>
    <attribute name="options">
      {"zoom":true,"convert_to_webp":true,"size":[0,270]}
    </attribute>
    <attribute name="string">
      Foto
    </attribute>
  </xpath>
</data>