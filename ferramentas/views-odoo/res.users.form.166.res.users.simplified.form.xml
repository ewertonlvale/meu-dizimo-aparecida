<!-- res.users · view 166 · res.users.simplified.form · base · form · prioridade 1 -->
<form string="Users">
  <sheet>
    <div class="d-flex gap-3 flex-column flex-sm-row mb-3">
      <div class="text-center">
        <field name="image_1920" widget="contact_image" options="{'preview_image': 'avatar_128', 'zoom': true, 'size': [130,130], 'img_class': 'border rounded h-100 object-fit-contain'}"/>
        <field name="avatar_128" invisible="1"/>
        <!-- Needed in contact_image widget -->
      </div>
      <group class="d-flex flex-column gap-md-0 w-100">
        <label for="name" class="d-md-none"/>
        <h1 class="d-flex align-items-baseline w-100">
          <field name="name" class="w-100" placeholder="e.g. John Doe" required="1"/>
        </h1>
        <label for="login" class="d-md-none"/>
        <div class="d-flex align-items-baseline w-md-50 gap-2">
          <field name="email" invisible="1"/>
          <!-- needed to update partner's email from on_change_login() -->
          <i class="d-none d-md-inline-flex fa fa-envelope" title="Email"/>
          <field name="email_domain_placeholder" invisible="1"/>
          <!-- needed to compute the placeholder whenever the dialog opens -->
          <field name="login" options="{'placeholder_field': 'email_domain_placeholder'}"/>
        </div>
        <label for="phone" class="d-md-none"/>
        <div class="d-flex align-items-baseline w-md-50 gap-2">
          <i class="d-none d-md-inline-flex fa fa-phone" title="Phone"/>
          <field name="phone" widget="phone" placeholder="Phone"/>
        </div>
        <label for="company_id" class="d-md-none" groups="base.group_multi_company"/>
        <div class="d-flex align-items-baseline w-md-50 gap-2" groups="base.group_multi_company">
          <i class="d-none d-md-inline-flex fa fa-building" title="Company"/>
          <field name="company_id" context="{'user_preference': 0}" placeholder="Company"/>
        </div>
      </group>
    </div>
    <group name="access_groups" invisible="id &gt; 0">
      <label for="group_ids" string="Access Rights" groups="base.group_no_one"/>
      <div groups="base.group_no_one">
        <field name="group_ids" readonly="1" widget="many2many_tags" style="display: inline;"/>
        You will be able to define additional access rights by editing the newly created user under the Settings / Users menu.
      </div>
    </group>
  </sheet>
</form>