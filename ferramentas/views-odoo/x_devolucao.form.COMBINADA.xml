<!-- x_devolucao · form combinada (via get_view) · view 604
     SOMENTE LEITURA: é o resultado das heranças, não existe como registro. O modo –update ignora este arquivo. -->
<form>
  <header>
    <field name="x_studio_validacao" widget="statusbar" options="{'clickable': '1'}"/>
  </header>
  <sheet string="Devolução">
    <widget name="web_ribbon" text="Arquivado" bg_color="text-bg-danger" invisible="x_active"/>
    <field name="x_active" invisible="1"/>
    <!-- A leitura do bot, à vista e só-leitura. Quem valida precisa dela para decidir, e não precisa poder mudá-la: ela é o que o OCR encontrou, não uma opinião que se revise. -->
    <div class="d-flex align-items-center gap-2 mb-2">
      <span class="text-muted small">
        Leitura automática do comprovante:
      </span>
      <field name="x_studio_status" widget="badge" readonly="1" nolabel="1" decoration-success="x_studio_status == 'Confirmado'" decoration-danger="x_studio_status == 'Rejeitado'" decoration-warning="x_studio_status == 'Pendente'"/>
    </div>
    <!-- O alerta da conferência sai do meio do formulário e vira banner no topo. Ele estava como um campo de texto entre outros dez, e é a informação que decide se este registro precisa de atenção humana. Some quando está 'ok', que é a maioria e não é notícia. O espaço depois dos dois-pontos é literal de propósito: sem ele o Odoo encosta o rótulo no valor e sai "Precisa de conferência:ausente". O valor ainda é o código cru — humanizar os rótulos da seleção é do lado do Odoo, não da view, e está no BL-61. -->
    <div class="alert alert-warning mb-3" role="alert" invisible="not x_studio_conferencia_pix or x_studio_conferencia_pix == 'ok'">
      <i class="fa fa-exclamation-triangle me-2" role="img" aria-label="Atenção"/>
      <span class="fw-bold">
        Precisa de conferência:
      </span>
      <field name="x_studio_conferencia_pix" readonly="1" nolabel="1" class="d-inline"/>
    </div>
    <div class="oe_title">
      <h1>
        <field name="x_name" required="1" placeholder="Name..."/>
      </h1>
    </div>
    <group name="studio_group_c89b90">
      <group name="studio_group_c89b90_left">
        <field name="x_studio_currency_id" invisible="1" can_create="True" can_write="True"/>
        <field name="x_studio_tipo_contribuicao" force_save="0" readonly="False" required="1"/>
        <field name="x_studio_dizimista" options="{&quot;create_name_field&quot;:&quot;x_name&quot;,&quot;no_create&quot;:true}" can_create="True" can_write="True"/>
        <!-- BL-41: o bot grava nome e telefone de quem ofertou sem ser cadastrado, e nenhum dos dois aparecia no formulário. Uma oferta anônima chegava à secretaria como um registro sem dono, com o dado ali do lado, invisível. -->
        <field name="x_studio_nome_ofertante" invisible="x_studio_dizimista"/>
        <field name="x_studio_telefone_ofertante" widget="phone" invisible="x_studio_dizimista"/>
        <field name="x_studio_comunidade" options="{&quot;create_name_field&quot;:&quot;x_name&quot;,&quot;no_create&quot;:true}" required="1" can_create="True" can_write="True"/>
        <field name="x_studio_competencia" options="{&quot;numeric&quot;:true}" widget="date" string="Mês Referencia"/>
        <field name="x_studio_data_da_devolucao" required="1"/>
        <field name="x_studio_value" required="1"/>
        <field name="x_studio_forma_de_pagamento"/>
      </group>
      <group name="studio_group_c89b90_right">
        <field name="x_studio_tipo_comprovante" invisible="1"/>
        <field name="x_studio_nome_arquivo" invisible="1"/>
        <field name="x_studio_comprovante" widget="image" nolabel="1" invisible="x_studio_tipo_comprovante != 'imagem'" string="Comprovante"/>
        <field name="x_studio_comprovante" widget="pdf_viewer" nolabel="1" invisible="x_studio_tipo_comprovante != 'pdf'" string="Comprovante"/>
        <div class="text-muted fst-italic" invisible="x_studio_comprovante">
          Sem comprovante anexado.
        </div>
      </group>
    </group>
  </sheet>
  <chatter/>
</form>