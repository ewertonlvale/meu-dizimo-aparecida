<!-- x_devolucao · view 679 · Default kanban view for ir.model(447,) · base · kanban · prioridade 16 -->
<kanban string="Devolução">
  <field name="x_studio_status"/>
  <!-- Declarado para as condições de `invisible` dos botões poderem lê-lo. -->
  <field name="x_studio_validacao"/>
  <templates>
    <t t-name="card">
      <div class="w-100">
        <div class="d-flex align-items-start justify-content-between mb-1">
          <field name="x_studio_value" class="fw-bold fs-4"/>
          <span t-attf-class="badge rounded-pill text-bg-{{ record.x_studio_status.raw_value == 'Confirmado' ? 'success' : record.x_studio_status.raw_value == 'Rejeitado' ? 'danger' : 'warning' }}" t-out="record.x_studio_status.value"/>
        </div>
        <field name="x_studio_dizimista" class="d-block text-truncate" invisible="not x_studio_dizimista"/>
        <field name="x_studio_nome_ofertante" class="d-block text-truncate" invisible="x_studio_dizimista or not x_studio_nome_ofertante"/>
        <div class="text-muted fst-italic small" invisible="x_studio_dizimista or x_studio_nome_ofertante or x_studio_tipo_contribuicao != 'oferta'">
          Oferta anônima
        </div>
        <div class="text-muted fst-italic small" invisible="x_studio_dizimista or x_studio_nome_ofertante or x_studio_tipo_contribuicao == 'oferta'">
          sem dizimista vinculado
        </div>
        <div class="text-muted small mt-1">
          <field name="x_studio_data_da_devolucao"/>
          <span invisible="not x_studio_forma_de_pagamento">
            ·
            <field name="x_studio_forma_de_pagamento"/>
          </span>
          <span invisible="not x_studio_tipo_contribuicao">
            ·
            <field name="x_studio_tipo_contribuicao"/>
          </span>
        </div>
        <div class="text-danger small fw-bold mt-1" invisible="x_studio_comprovante">
          ⚠ sem comprovante
        </div>
        <div class="text-warning small mt-1" invisible="not x_studio_conferencia_pix or x_studio_conferencia_pix == 'ok'">
          ⚠ conferência:
          <field name="x_studio_conferencia_pix"/>
        </div>

        <!-- A validação do coordenador, para varrer com o olho (BL-60).
             O badge de cima é a leitura do bot; este é o julgamento humano.
             Cinza enquanto ninguém olhou, verde quando o dinheiro entrou,
             vermelho quando não entrou. -->
        <div class="mt-2">
          <span t-attf-class="badge rounded-pill text-bg-{{ record.x_studio_validacao.raw_value == 'validado' ? 'success' : record.x_studio_validacao.raw_value == 'nao_recebido' ? 'danger' : 'secondary' }}" t-out="record.x_studio_validacao.value"/>
        </div>

        <!-- MARCADOR-BOTOES-VALIDACAO
             Os dois botões entram AQUI, e não neste arquivo, porque cada um
             chama uma ir.actions.server por ID numérico — e esse ID só existe
             depois de alguém rodar ferramentas/instalar-botoes-kanban.mjs
             contra esta instância. Escrever um número aqui às cegas produziria
             um botão que aponta para o nada.

             O instalador substitui este comentário pelos botões, direto no
             Odoo. Depois um –download traz o resultado para cá, já com os IDs
             certos, e a view volta a percorrer o caminho normal.

             Enquanto o instalador não roda, o card funciona sem os botões: o
             badge acima mostra o estado, e a barra do formulário continua
             sendo onde se valida. -->
      </div>
    </t>
  </templates>
</kanban>