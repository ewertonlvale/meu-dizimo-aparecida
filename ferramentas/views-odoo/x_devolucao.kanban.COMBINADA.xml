<!-- x_devolucao · kanban combinada (via get_view) · view 679
     SOMENTE LEITURA: é o resultado das heranças, não existe como registro. O modo –update ignora este arquivo. -->
<kanban string="Devolução">
  <field name="x_studio_status"/>
  <!-- Declarado para as condições de `invisible` dos botões poderem lê-lo. -->
  <field name="x_studio_validacao"/>
  <templates>
    <t t-name="card">
      <div class="w-100">
        <div class="d-flex align-items-start justify-content-between mb-1">
          <field name="x_studio_value" class="fw-bold fs-4"/>
          <span t-attf-class="badge rounded-pill text-bg-{{ record.x_studio_status.raw_value == 'Confirmado' ? 'success' : record.x_studio_status.raw_value == 'Rejeitado' ? 'danger' : record.x_studio_status.raw_value == 'A devolver' ? 'secondary' : 'warning' }}" t-out="record.x_studio_status.value"/>
        </div>
        <field name="x_studio_dizimista" class="d-block text-truncate" invisible="not x_studio_dizimista"/>
        <field name="x_studio_nome_ofertante" class="d-block text-truncate" invisible="x_studio_dizimista or not x_studio_nome_ofertante"/>
        <div class="text-muted fst-italic small" invisible="x_studio_dizimista or x_studio_nome_ofertante or x_studio_tipo_contribuicao != 'oferta'">
          Oferta anônima
        </div>
        <div class="text-muted fst-italic small" invisible="x_studio_dizimista or x_studio_nome_ofertante or x_studio_tipo_contribuicao == 'oferta'">
          sem dizimista vinculado
        </div>
        <div class="text-muted small mt-1">
          <field name="x_studio_data_da_devolucao"/>
          <span invisible="not x_studio_forma_de_pagamento">
            ·
            <field name="x_studio_forma_de_pagamento"/>
          </span>
          <span invisible="not x_studio_tipo_contribuicao">
            ·
            <field name="x_studio_tipo_contribuicao"/>
          </span>
        </div>
        <div class="text-danger small fw-bold mt-1" invisible="x_studio_comprovante">
          ⚠ sem comprovante
        </div>
        <!-- BL-61: texto humano no lugar do código. Aqui as frases são curtas — é card, não formulário. O motivo de a tradução morar na view (e não em rótulo de seleção) está no arch do formulário. -->
        <div class="text-warning small mt-1" invisible="not x_studio_conferencia_pix or x_studio_conferencia_pix == 'ok'">
          <span invisible="x_studio_conferencia_pix != 'ausente'">
            ⚠ chave PIX não identificada no comprovante
          </span>
          <span invisible="x_studio_conferencia_pix != 'divergente'">
            ⚠ chave do comprovante diverge da comunidade
          </span>
          <span invisible="x_studio_conferencia_pix != 'sem_referencia'">
            ⚠ comunidade sem chave PIX cadastrada
          </span>
          <span invisible="x_studio_conferencia_pix != 'titular_divergente'">
            ⚠ titular diverge do cadastrado
          </span>
          <span invisible="x_studio_conferencia_pix != 'banco_divergente'">
            ⚠ banco de destino diverge
          </span>
          <span invisible="x_studio_conferencia_pix != 'tudo_divergente'">
            🚨 titular E banco divergem
          </span>
          <span invisible="x_studio_conferencia_pix != 'comprovante_antigo'">
            ⚠ comprovante com data antiga
          </span>
          <span invisible="x_studio_conferencia_pix != 'comprovante_futuro'">
            🚨 comprovante com data no futuro
          </span>
          <span invisible="x_studio_conferencia_pix in ['ok', 'ausente', 'divergente', 'sem_referencia', 'titular_divergente', 'banco_divergente', 'tudo_divergente', 'comprovante_antigo', 'comprovante_futuro']">
            ⚠ conferência:
            <field name="x_studio_conferencia_pix"/>
          </span>
        </div>
        <!-- A validação do coordenador, para varrer com o olho (BL-60). O badge de cima é a leitura do bot; este é o julgamento humano. Cinza enquanto ninguém olhou, verde quando o dinheiro entrou, vermelho quando não entrou. -->
        <!-- A validação some no "A devolver": mês que ninguém pagou não tem o que validar, e enchê-la de meses futuros arruinaria a fila do coordenador, que é justamente a tela que o BL-60 criou. -->
        <div class="mt-2" t-if="record.x_studio_status.raw_value != 'A devolver'">
          <span t-attf-class="badge rounded-pill text-bg-{{ record.x_studio_validacao.raw_value == 'validado' ? 'success' : record.x_studio_validacao.raw_value == 'nao_recebido' ? 'danger' : 'secondary' }}" t-out="record.x_studio_validacao.value"/>
        </div>
        <div class="mt-2 d-flex gap-1">
          <button name="234" type="action" class="btn btn-sm btn-outline-success" invisible="x_studio_validacao == 'validado' or x_studio_status == 'A devolver'">
            Validado
          </button>
          <button name="235" type="action" class="btn btn-sm btn-outline-danger" invisible="x_studio_validacao == 'nao_recebido' or x_studio_status == 'A devolver'">
            Não recebido
          </button>
        </div>
      </div>
    </t>
  </templates>
  <field name="x_studio_comprovante" invisible="True" readonly="True" data-used-by="invisible='x_studio_comprovante' (div,None)"/>
</kanban>