<!-- x_devolucao · view 644 · Odoo Studio: Default search view for x_devolucao customization · herda de 605 · search · prioridade 99 -->
<data>
  <xpath expr="/search//field[@name='x_name']" position="before">
    <field name="x_studio_dizimista"/>
    <field name="x_studio_comunidade"/>
  </xpath>
  <xpath expr="/search/separator" position="after">
    <filter name="studio_filter_8fb_1ji0qilv3" string="Mês Atual"
            domain="[('x_studio_data_da_devolucao', '&gt;=', (context_today().replace(day=1)).strftime('%Y-%m-%d')),
                     ('x_studio_data_da_devolucao', '&lt;', ((context_today().replace(day=1)) + relativedelta(months=1)).strftime('%Y-%m-%d'))]"/>
    <filter name="filtro_aguardando" string="Aguardando conferência"
            domain="[('x_studio_status', '=', 'Pendente')]"/>
    <filter name="filtro_rejeitadas" string="Rejeitadas"
            domain="[('x_studio_status', '=', 'Rejeitado')]"/>
    <separator/>
    <filter name="filtro_sem_comprovante" string="Sem comprovante"
            domain="[('x_studio_comprovante', '=', False)]"/>
    <filter name="filtro_sem_comunidade" string="Sem comunidade"
            domain="[('x_studio_comunidade', '=', False)]"/>
  </xpath>
  <xpath expr="/search/separator[2]" position="after">
    <group name="studio_group_by"/>
    <filter name="studio_group_by_6rd_1ji0pb9u5" string="Status" context="{'group_by': 'x_studio_status'}"/>
    <filter name="studio_group_by_7b_1ji0pbs65" string="Mês Referencia" context="{'group_by': 'x_studio_competencia'}"/>
    <filter name="studio_group_by_38d_1ji0p9jjo" string="Comunidade" context="{'group_by': 'x_studio_comunidade'}"/>
  </xpath>
</data>