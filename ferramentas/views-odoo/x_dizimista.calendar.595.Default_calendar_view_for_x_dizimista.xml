<!-- x_dizimista · view 595 · Default calendar view for x_dizimista · base · calendar · prioridade 16 -->
<!-- ANIVERSARIANTES POR COMUNIDADE (BL-65)

     ANTES ESTA VIEW APONTAVA PARA x_studio_date, QUE É A DATA DE NASCIMENTO.
     O calendário posiciona o evento pela data que o campo guarda, e o campo
     guarda 14/03/1975. Ou seja: a view existia, abria, e não mostrava ninguém
     em mês nenhum dos que alguém abriria. Não havia erro, não havia aviso —
     só um calendário vazio, que parece "ninguém faz aniversário".

     x_studio_aniversario é o mesmo dia e mês no ano corrente, mantido por uma
     ação agendada diária (ferramentas/odoo-acoes/atualizar-aniversarios.py).
     Campo calculado não serviria: ele recalcula quando a dependência muda, e
     aqui o que muda é o ANO, que não é dependência de nada.

     create="false" de propósito: criar dizimista arrastando no calendário
     produziria uma pessoa com data e mais nada — sem comunidade, sem telefone,
     invisível para o bot. Cadastro se faz no formulário. -->
<calendar date_start="x_studio_aniversario"
          create_name_field="x_name"
          color="x_studio_comunidade"
          mode="month"
          create="false"
          quick_create="false"
          event_open_popup="true"
          hide_time="true">
  <!-- `filters` é o que põe a coluna de marcar/desmarcar comunidade ao lado do
       calendário. Sem ele o coordenador vê as seis comunidades misturadas e
       não tem como isolar a dele. `color` no topo dá uma cor por comunidade. -->
  <field name="x_studio_comunidade" filters="1"/>

  <!-- Estes aparecem no balão ao clicar no nome, em vez de abrir a ficha
       inteira. É o que se precisa saber para mandar a mensagem de parabéns:
       quem é, de onde é, e o número. -->
  <field name="x_studio_partner_phone" string="Telefone"/>
  <field name="x_studio_date" string="Nascimento"/>
  <field name="x_studio_classificacao" string="Classificação"/>
</calendar>
