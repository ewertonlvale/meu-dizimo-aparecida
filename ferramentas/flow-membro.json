{
  "version": "7.1",
  "screens": [
    {
      "id": "MEMBRO",
      "title": "Membro da Família",
      "terminal": true,
      "data": {
        "comunidade": {
          "type": "string",
          "__example__": "Comunidade São José"
        },
        "endereco_padrao": {
          "type": "string",
          "__example__": "Rua das Flores, 123, Centro"
        },
        "dia_padrao": {
          "type": "string",
          "__example__": "10"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "form_membro",
            "init-values": {
              "endereco": "${data.endereco_padrao}",
              "dia_preferido": "${data.dia_padrao}"
            },
            "children": [
              {
                "type": "TextSubheading",
                "text": "Dados do familiar"
              },
              {
                "type": "TextBody",
                "text": "Comunidade: ${data.comunidade}"
              },
              {
                "type": "TextInput",
                "name": "nome",
                "label": "Nome completo",
                "input-type": "text",
                "required": true,
                "min-chars": 3,
                "max-chars": 80
              },
              {
                "type": "TextInput",
                "name": "nome_usual",
                "label": "Como chamar",
                "input-type": "text",
                "required": true,
                "min-chars": 2,
                "max-chars": 40,
                "helper-text": "Apelido ou nome de preferência do familiar"
              },
              {
                "type": "TextInput",
                "name": "data_nascimento",
                "label": "Nascimento",
                "input-type": "text",
                "required": true,
                "min-chars": 8,
                "max-chars": 10,
                "helper-text": "Formato DD/MM/AAAA. Exemplo: 15/03/1990"
              },
              {
                "type": "TextArea",
                "name": "endereco",
                "label": "Endereço",
                "required": true,
                "max-length": 200,
                "helper-text": "Já vem com o seu endereço. Altere se for diferente."
              },
              {
                "type": "TextInput",
                "name": "valor_mensal",
                "label": "Dízimo mensal (R$)",
                "input-type": "number",
                "required": true,
                "helper-text": "Só o valor. É uma referência, pode variar a cada mês."
              },
              {
                "type": "TextInput",
                "name": "dia_preferido",
                "label": "Dia da devolução",
                "input-type": "number",
                "required": true,
                "helper-text": "De 1 a 28. Já vem com o seu dia."
              },
              {
                "type": "Footer",
                "label": "Adicionar familiar",
                "on-click-action": {
                  "name": "complete",
                  "payload": {
                    "nome": "${form.nome}",
                    "nome_usual": "${form.nome_usual}",
                    "data_nascimento": "${form.data_nascimento}",
                    "endereco": "${form.endereco}",
                    "valor_mensal": "${form.valor_mensal}",
                    "dia_preferido": "${form.dia_preferido}"
                  }
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
